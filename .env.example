# Copia este archivo con el nombre ".env" y llena tus datos.
# El archivo ".env" NUNCA se sube a GitHub (ya está en .gitignore).

# Datos de tu PostgreSQL (los que pusiste al instalarlo)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_clave_de_postgresql
DB_NAME=queens_be_alejandra

# Puerto donde corre la página
PORT=3000

# Opcional: nombre de la base de datos para las pruebas (debe terminar en _test)
# DB_NAME_TEST=queens_be_alejandra_test

# ---- SOLO cuando publiques la página en un hosting (en tu computador NO) ----
# NODE_ENV=production
# TRUST_PROXY=1
# DB_SSL=true
# Muchos hostings entregan una sola dirección de base de datos:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/basededatos

# ---- Avisos por Telegram a Alejandra (opcional, ver README) ----
# TELEGRAM_BOT_TOKEN=el_token_que_te_da_BotFather
# TELEGRAM_CHAT_ID=el_numero_de_chat_de_alejandra
# Dirección pública de la página (para que el aviso lleve el enlace al panel):
# PUBLIC_URL=https://tu-dominio.com
